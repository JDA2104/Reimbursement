# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke git (sudah masuk .gitignore).

# --- Telegram ---
# Dapatkan dari @BotFather di Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Daftar Telegram user ID yang boleh memakai bot, dipisah koma.
# Cara tahu ID kamu: jalankan bot, kirim /start, bot akan menampilkan ID-mu.
ALLOWED_TELEGRAM_USER_IDS=

# --- Claude ---
ANTHROPIC_API_KEY=
# Ganti ke claude-sonnet-5 kalau ingin lebih murah dan cepat.
CLAUDE_MODEL=claude-opus-5

# --- Email (SMTP) ---
# Contoh Office 365 : smtp.office365.com  port 587
# Contoh Gmail      : smtp.gmail.com      port 587  (pakai App Password, bukan password akun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Penerima rekap (petugas yang mengumpulkan). Boleh lebih dari satu, dipisah koma.
EMAIL_TO=

# --- Perusahaan ---
COMPANY_NAME=
CURRENCY=IDR
