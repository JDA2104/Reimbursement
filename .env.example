# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke git (sudah masuk .gitignore).

# --- Telegram ---
# Dapatkan dari @BotFather di Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Telegram user ID yang boleh memakai bot, dipisah koma.
# Belum tahu ID-mu? Isi 0 dulu, jalankan bot, kirim /start — bot akan memberitahu.
ALLOWED_TELEGRAM_USER_IDS=

# --- OpenAI ---
OPENAI_API_KEY=
# Model yang dipakai untuk baca struk & pilah kalimat. Harus mendukung vision.
OPENAI_MODEL=gpt-4o

# --- Identitas karyawan (mengisi kepala form Excel) ---
KARYAWAN_NAMA=
KARYAWAN_NPK=
KARYAWAN_JABATAN=
KARYAWAN_DEPARTEMEN=
PERUSAHAAN=

# Nilai default kolom yang jarang berubah
DEFAULT_TIPE=meal
DEFAULT_TUJUAN=Maintain/Build Relation

# Jumlah baris kosong yang tetap dicetak di form
FORM_MIN_ROWS=20
CURRENCY=IDR

# --- Database cloud (hanya perlu kalau dashboard dideploy ke Vercel) ---
# Buat gratis di https://turso.tech → Create Database → Connect.
# Kosongkan keduanya kalau dashboard cukup dipakai lokal — bot tetap jalan penuh.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Email (SMTP) ---
# Office 365 : smtp.office365.com  port 587
# Gmail      : smtp.gmail.com      port 587  (pakai App Password, bukan password akun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Penerima form rekap. Boleh lebih dari satu, dipisah koma.
EMAIL_TO=
